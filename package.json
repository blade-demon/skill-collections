{
  "name": "skill-collections",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for Anthropic-style skills and hands-on samples that exercise them.",
  "workspaces": [
    "skills/*",
    "samples/*/*"
  ],
  "scripts": {
    "test:skills": "npm test --workspace skills/design-to-spec --workspace skills/html-article-to-markdown",
    "test:skill": "npm run test:skills",
    "build:samples": "npm run build --workspace samples/design-to-spec/search-panel --workspace samples/design-to-spec/feedback-form --if-present",
    "lint:samples": "npm run lint --workspace samples/design-to-spec/search-panel --workspace samples/design-to-spec/feedback-form --if-present",
    "check": "npm run test:skills && npm run lint:samples && npm run build:samples"
  },
  "engines": {
    "node": ">=20"
  }
}
