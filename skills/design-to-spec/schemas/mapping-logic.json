{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "design-to-spec Mapping_Logic",
  "type": "object",
  "required": ["mapping"],
  "additionalProperties": false,
  "properties": {
    "mapping": {
      "type": "object",
      "required": ["component", "data_fetching", "bindings", "state_machine", "open_questions"],
      "additionalProperties": false,
      "properties": {
        "component": { "type": "string", "minLength": 1 },
        "data_fetching": {
          "type": "object",
          "required": ["requests"],
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "trigger",
                  "endpoint",
                  "call_type",
                  "loading_state",
                  "depends_on"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
                  "trigger": { "type": "string", "minLength": 1 },
                  "endpoint": { "type": "string" },
                  "call_type": {
                    "type": "string",
                    "enum": ["user_triggered", "on_mount", "polling", "realtime"]
                  },
                  "loading_state": { "type": "boolean" },
                  "depends_on": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  }
                }
              }
            },
            "cache": {
              "type": "object",
              "additionalProperties": true
            },
            "cache_policy": {
              "type": "object",
              "required": ["strategy"],
              "additionalProperties": false,
              "properties": {
                "strategy": { "type": "string", "minLength": 1 },
                "key_fields": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                },
                "ttl": { "type": "string" },
                "stale_behavior": { "type": "string" },
                "notes": { "type": "string" }
              }
            },
            "retry_policy": {
              "type": "object",
              "required": ["strategy"],
              "additionalProperties": false,
              "properties": {
                "strategy": { "type": "string", "minLength": 1 },
                "max_attempts": { "type": "number" },
                "backoff": { "type": "string" },
                "notes": { "type": "string" }
              }
            },
            "concurrency_policy": {
              "type": "object",
              "required": ["abortable", "stale_response"],
              "additionalProperties": false,
              "properties": {
                "abortable": { "type": "boolean" },
                "dedupe_key": { "type": "string" },
                "stale_response": {
                  "type": "string",
                  "enum": ["ignore", "apply_latest", "block_new", "needs_human_input"]
                },
                "notes": { "type": "string" }
              }
            }
          }
        },
        "bindings": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": ["source_ui", "target_api", "direction"],
                "additionalProperties": false,
                "properties": {
                  "source_ui": { "type": "string", "minLength": 1 },
                  "target_api": { "type": "string", "minLength": 1 },
                  "direction": { "const": "ui_to_api" },
                  "transform": { "type": "string" }
                }
              },
              {
                "type": "object",
                "required": ["source_api", "target_ui", "direction", "transform"],
                "additionalProperties": false,
                "properties": {
                  "source_api": { "type": "string", "minLength": 1 },
                  "target_ui": { "type": "string", "minLength": 1 },
                  "direction": { "const": "api_to_ui" },
                  "transform": { "type": "string" }
                }
              },
              {
                "type": "object",
                "required": ["source_ui", "target_event", "direction", "transform"],
                "additionalProperties": false,
                "properties": {
                  "source_ui": { "type": "string", "minLength": 1 },
                  "target_event": { "type": "string", "minLength": 1 },
                  "direction": { "const": "ui_to_event" },
                  "transform": { "type": "string" }
                }
              }
            ]
          }
        },
        "state_machine": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "event", "to"],
            "additionalProperties": false,
            "properties": {
              "from": { "type": "string", "minLength": 1 },
              "event": { "type": "string", "minLength": 1 },
              "to": { "type": "string", "minLength": 1 },
              "render_assertion": { "type": "string" }
            }
          }
        },
        "open_questions": { "$ref": "#/definitions/openQuestions" }
      }
    }
  },
  "definitions": {
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "content", "priority"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "content": { "type": "string", "minLength": 1 },
          "priority": { "type": "string", "enum": ["P0", "P1", "P2"] }
        }
      }
    }
  }
}
